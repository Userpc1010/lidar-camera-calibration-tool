clean: sub-CalibrationGUI-clean sub-CalibrationCore-clean  FORCE
distclean: sub-CalibrationGUI-distclean sub-CalibrationCore-distclean  FORCE
	-$(DEL_FILE) Makefile
	-$(DEL_FILE) .qmake.stash
install_subtargets: sub-CalibrationGUI-install_subtargets sub-CalibrationCore-install_subtargets FORCE
uninstall_subtargets: sub-CalibrationGUI-uninstall_subtargets sub-CalibrationCore-uninstall_subtargets FORCE

sub-CalibrationGUI-check:
	@test -d CalibrationGUI/ || mkdir -p CalibrationGUI/
	cd CalibrationGUI/ && ( test -e Makefile || $(QMAKE) -o Makefile /home/sencis/CalibrationTools/CalibrationTools/CalibrationGUI/CalibrationGUI.pro -spec linux-g++ CONFIG+=debug CONFIG+=qml_debug ) && $(MAKE) -f Makefile check
sub-CalibrationCore-check: sub-CalibrationGUI-check
	@test -d CalibrationCore/ || mkdir -p CalibrationCore/
	cd CalibrationCore/ && ( test -e Makefile || $(QMAKE) -o Makefile /home/sencis/CalibrationTools/CalibrationTools/CalibrationCore/CalibrationCore.pro -spec linux-g++ CONFIG+=debug CONFIG+=qml_debug ) && $(MAKE) -f Makefile check
check: sub-CalibrationGUI-check sub-CalibrationCore-check

sub-CalibrationGUI-benchmark:
	@test -d CalibrationGUI/ || mkdir -p CalibrationGUI/
	cd CalibrationGUI/ && ( test -e Makefile || $(QMAKE) -o Makefile /home/sencis/CalibrationTools/CalibrationTools/CalibrationGUI/CalibrationGUI.pro -spec linux-g++ CONFIG+=debug CONFIG+=qml_debug ) && $(MAKE) -f Makefile benchmark
sub-CalibrationCore-benchmark: sub-CalibrationGUI-benchmark
	@test -d CalibrationCore/ || mkdir -p CalibrationCore/
	cd CalibrationCore/ && ( test -e Makefile || $(QMAKE) -o Makefile /home/sencis/CalibrationTools/CalibrationTools/CalibrationCore/CalibrationCore.pro -spec linux-g++ CONFIG+=debug CONFIG+=qml_debug ) && $(MAKE) -f Makefile benchmark
benchmark: sub-CalibrationGUI-benchmark sub-CalibrationCore-benchmark
